[project]
name = "hybrid-vtol-neuro-fusion"
version = "0.1.0"
description = "Neuro-Adaptive Sensor Fusion for Hybrid VTOL UAV — Companion Computer stack (RPi 5 + Cube Orange+)"
readme = "README.md"
license = { text = "MIT" }
requires-python = ">=3.10"
authors = [
    { name = "Sparsh" },
]

dependencies = [
    "numpy>=1.26,<2",
    "scipy>=1.12",
    "tensorflow-cpu>=2.16",      # Training pipeline (x86 / Apple Silicon host)
    "tflite-runtime>=2.14",      # On-device inference (Raspberry Pi 5)
    "mavsdk>=2.1",               # MAVLink / MAVProxy communication
]

[project.optional-dependencies]
ros = [
    # rclpy is provided by the ROS 2 Humble system installation.
    # Listed here for documentation; install via `rosdep`, NOT pip.
    # "rclpy",
]
dev = [
    "pytest>=8.0",
    "ruff>=0.5",
    "pre-commit>=3.7",
]
viz = [
    "matplotlib>=3.9",
    "plotly>=5.22",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["ml_core", "src/neuro_adaptive_fusion/neuro_adaptive_fusion"]

# ── Tooling ──────────────────────────────────────────────────────────────────
[tool.ruff]
target-version = "py310"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "SIM"]

[tool.pytest.ini_options]
testpaths = ["tests"]
